# -----------------------------------------------------------------------------
# GIA PHẢ OS - MẪU BIẾN MÔI TRƯỜNG CẤU HÌNH (ENVIRONMENT VARIABLES)
# -----------------------------------------------------------------------------
# Hướng dẫn:
# 1. Chép (copy) file này thành ".env.local"
# 2. Điền các giá trị thực tế tương ứng với dự án Supabase của bạn
# 3. Không bọc giá trị trong dấu nháy, kể cả khi có khoảng trắng (Gia Phả OS):
#    "docker run --env-file" giữ nguyên dấu nháy trong giá trị

# Tên của ứng dụng web được hiển thị cho người dùng
SITE_NAME=Suối Nguồn Yêu Thương

# Tên ngắn hiện dưới biểu tượng khi cài ứng dụng lên màn hình chính điện thoại
SHORT_NAME=Gia Phả

# URL của project Supabase (Lấy từ Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Khóa Public (Lấy từ Settings > API > Project API keys > anon / public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-or-public-key

# Public origin for share links, metadata and sitemap.
APP_URL=https://your-domain.vercel.app

# Server-only: PostgreSQL connection string dùng cho công cụ migration trong Dashboard.
# Lấy tại Supabase Dashboard > Project Settings > Database > Connection Pooling (Session mode).
# Không dùng anon/service-role key ở biến này và tuyệt đối không đưa lên client.
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# Server-only local login; configure both credentials privately.
ADMIN_USERNAME=
ADMIN_PASSWORD=
